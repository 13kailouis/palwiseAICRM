# =============================================================================
# Palwise - pengaturan
#
# Salin file ini jadi ".env" lalu isi yang kosong.
# Sengaja hanya memakai huruf biasa (tanpa simbol khusus) supaya tidak
# berantakan waktu dibuka di Notepad atau editor lain.
# =============================================================================


# --- Layanan AI --------------------------------------------------------------
# Default: Gemini. Paling murah, bisa baca gambar dan pesan suara,
# dan Bahasa Indonesianya bagus.
# Ambil API key gratis di https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Kelas Lite, dan itu keputusan HARGA yang menentukan produknya untung atau
# tidak. Diukur 8 Agustus 2026 dari halaman harga resmi Google:
#
#   gemini-3.5-flash        $1,50 masuk / $9,00 keluar  -> Rp 153 per balasan
#   gemini-3.1-flash-lite   $0,25 masuk / $1,50 keluar  -> Rp  26 per balasan
#
# Paket Growth dijual Rp 33 per balasan, jadi dengan 3.5 Flash setiap balasan
# rugi Rp 120. Yang bikin celaka harga KELUARANNYA, bukan masukannya.
#
# Jangan naik kelas tanpa menghitung ulang harga paket dulu.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Model cadangan. Model unggulan Google kadang penuh dan menolak permintaan
# selama berjam-jam. Kalau itu terjadi, Palwise pindah ke sini otomatis supaya
# pelanggan tetap dibalas. Kosongkan kalau tidak mau pakai cadangan.
#
# WAJIB model yang BERBEDA dari yang di atas. Kalau sama, cadangannya tidak ada
# gunanya justru waktu model utamanya yang penuh.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Kalau suatu saat asisten berhenti menjawab, jalankan "npm run models".
# Google kadang menghentikan model lama dan namanya harus diganti di sini.

# Model Gemini terbaru "berpikir" dulu sebelum menjawab, dan itu ditagih
# sebagai keluaran. Untuk menjawab dari info bisnis, mematikannya menghasilkan
# jawaban yang sama tapi jauh lebih murah dan cepat. Isi "on" kalau kamu punya
# kasus yang butuh penalaran bertingkat.
GEMINI_THINKING=off

# Opsional. Hanya dipakai kalau AI_PROVIDER diganti.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# --- Database ----------------------------------------------------------------
# SQLite lokal, tidak perlu install apa-apa.
# Ganti ke Postgres saat sudah dipakai pelanggan sungguhan.
DATABASE_URL="file:../../../data/palwise.db"


# --- Mesin WhatsApp dan AI ---------------------------------------------------
WORKER_PORT=4000
# Pakai 127.0.0.1, BUKAN localhost. Mesinnya mendengarkan di IPv4 saja demi
# keamanan, sedangkan nama "localhost" di Windows diterjemahkan ke IPv6 lebih
# dulu. Kode dashboard sudah membetulkannya sendiri, ini biar jelas saja.
WORKER_URL=http://127.0.0.1:4000

# Antarmuka yang didengarkan mesinnya. Bawaannya 127.0.0.1, artinya cuma bisa
# dijangkau dari mesin yang sama. Biarkan begitu kecuali dashboard-nya benar-
# benar jalan di server lain, dan kalau begitu pasang firewall sekalian.
# WORKER_HOST=127.0.0.1

# Kata sandi antara dashboard dan mesinnya. Ganti dengan huruf acak.
#
# Ini satu-satunya yang memisahkan mesinnya dari siapa pun yang bisa menjangkau
# portanya. Kalau dibiarkan bawaan, mesinnya MENOLAK jalan waktu NODE_ENV
# production, karena nilai bawaannya tertulis di dalam kode dan bukan kunci
# sama sekali.
INTERNAL_TOKEN=ganti-dengan-huruf-acak-yang-panjang

# Tempat menyimpan sesi WhatsApp dan lampiran dari pelanggan
WA_SESSION_DIR=./data/wa-sessions
MEDIA_DIR=./data/media

# Zona waktu untuk fitur jam kerja
TIMEZONE=Asia/Jakarta


# --- Dashboard ---------------------------------------------------------------
# Kunci untuk menjaga sesi login. Ganti dengan huruf acak.
AUTH_SECRET=ganti-dengan-huruf-acak-yang-panjang-juga
NEXT_PUBLIC_APP_NAME=Palwise

# Alamat situs. Kosongkan waktu jalan di laptop: semuanya lewat satu alamat.
#
# Kalau diisi, halaman jualan dan dashboard dipisah:
#   NEXT_PUBLIC_SITE_URL=https://palwise.id
#   NEXT_PUBLIC_APP_URL=https://app.palwise.id
#
# Isi keduanya atau tidak sama sekali. Kalau cuma satu yang diisi, aplikasinya
# tetap jalan di satu alamat seperti biasa.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# --- Pembayaran (Midtrans) ---------------------------------------------------
# Ambil di dashboard.midtrans.com, menu Settings > Access Keys.
#
# Kalau SERVER KEY dikosongkan, tombol paket berbayar menolak dengan sopan dan
# menyuruh menghubungi kamu. Yang TIDAK terjadi: paketnya naik tanpa dibayar.
#
# Server key ini juga yang dipakai membuktikan notifikasi dari Midtrans benar
# dari mereka. Alamat webhook-nya terbuka ke internet dan memang harus begitu,
# jadi kunci inilah satu-satunya yang memisahkan "sudah bayar" dari siapa pun
# yang tahu alamatnya.
MIDTRANS_SERVER_KEY=

# Bawaannya SANDBOX. Isi "on" cuma di server yang benar-benar melayani
# pelanggan.
#
# Bawaan yang salah harus selalu mengarah ke yang tidak merugikan siapa pun:
# sandbox di server sungguhan cuma bikin pembayaran tidak jadi, sedangkan
# production di laptop menagih uang sungguhan waktu kamu sedang mencoba.
MIDTRANS_PRODUCTION=

# Di dashboard Midtrans, menu Settings > Configuration, isi Payment
# Notification URL dengan:
#   https://app.palwise.id/api/pembayaran/midtrans
# Tanpa itu uangnya masuk tapi paketnya tidak pernah naik, dan tidak ada satu
# pun pesan galat yang muncul di mana pun.


# --- Halaman founder ---------------------------------------------------------
# Email yang boleh membuka /app/founder, dipisah koma.
#
# KALAU DIKOSONGKAN, HALAMANNYA TIDAK ADA sama sekali (dijawab 404, bukan
# "kamu tidak punya akses", supaya keberadaannya tidak ikut bocor).
#
# Sengaja dari .env, bukan kolom di database: satu-satunya cara menambah orang
# jadi harus punya akses ke server. Kolom di database bisa berubah lewat bug di
# halaman mana pun, berkas ini tidak.
#
# Yang TIDAK ada di halaman itu, dan sengaja: isi chat pelanggan. Kebijakan
# privasi menulis data pelanggan "tidak dibaca karyawan kami", dan halaman yang
# bisa membuka obrolan orang membuat kalimat itu bohong.
FOUNDER_EMAILS=


# --- Email -------------------------------------------------------------------
# Dipakai untuk tautan lupa password. Ambil kunci gratis di https://resend.com
#
# Kalau dikosongkan, emailnya TIDAK dikirim tapi isinya ditulis ke layar server,
# jadi seluruh alurnya tetap bisa dicoba di laptop tanpa daftar ke mana-mana.
#
# EMAIL_FROM harus memakai domain yang sudah kamu daftarkan di Resend.
RESEND_API_KEY=
EMAIL_FROM=Palwise <noreply@palwise.id>
